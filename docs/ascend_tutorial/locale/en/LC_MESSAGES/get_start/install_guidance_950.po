""

msgid ""
"    # 安装 MindSpeed-Bridge（仓库默认分支）\n"
"    git clone --depth 1 https://gitcode.com/ascend/MindSpeed-Bridge.git\n"
"    pip install -e MindSpeed-Bridge --no-deps\n"
